# AI Provider selection: 'gemini' or 'openai' (which can be configured for OpenAI, OpenRouter, Fireworks, etc.)
AI_PROVIDER=openai

# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenRouter / Fireworks configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-v4-flash

# API behavior settings
TARGET_KEYWORD_MATCH=75
DEFAULT_REWRITE_MODE=transferable

